{
  "name": "trixelator-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "dev:desktop": "pnpm --dir apps/desktop dev",
    "build:web": "pnpm --dir apps/web build",
    "build:desktop": "pnpm --dir apps/desktop build",
    "dist": "pnpm --dir apps/desktop dist",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {}
}
